# Copy to .env for local development. On Replit these go in Secrets instead,
# where they are not written to the repository.

# ── Required before the event ────────────────────────────────────────────────

# Signs every session token. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app logs a loud warning at startup if this is still the default.
EXCHANGE_SECRET_KEY=change-me

# ── Database ─────────────────────────────────────────────────────────────────

# Leave this unset on a host that provides DATABASE_URL (Replit with the
# PostgreSQL module enabled, Heroku, Railway). The app adopts that connection
# automatically and converts it to the asyncpg form. Setting this always wins.
#
# EXCHANGE_DATABASE_URL=postgresql+asyncpg://user:password@localhost/exchange
#
# Local development, no server needed. SQLite is exact here: money is stored as
# a scaled integer, so it agrees with PostgreSQL to the paisa.
EXCHANGE_DATABASE_URL=sqlite+aiosqlite:///./data/exchange.db

# How hard SQLite fsyncs. FULL survives a container being killed mid-write and
# is what the event should run. NORMAL is faster and is what the tests use.
EXCHANGE_SQLITE_SYNCHRONOUS=FULL

# ── Server ───────────────────────────────────────────────────────────────────

EXCHANGE_HOST=0.0.0.0
EXCHANGE_PORT=8000
EXCHANGE_LOG_LEVEL=INFO

# Sets the Secure flag on session cookies. Must be true anywhere served over
# HTTPS, which is anywhere real.
EXCHANGE_SECURE_COOKIES=false

# ── Sessions ─────────────────────────────────────────────────────────────────

EXCHANGE_ACCESS_TOKEN_MINUTES=30
# Long enough to cover a whole competition, so a phone that locked itself
# during a break does not force a sign-in at the open.
EXCHANGE_REFRESH_TOKEN_HOURS=14

# ── Rules ────────────────────────────────────────────────────────────────────

# The rulebook itself lives in config/rules.yaml, not here.
EXCHANGE_RULES_FILE=config/rules.yaml

# Set false to stop the tick loop from starting. Only the test suite wants this.
EXCHANGE_RUN_ENGINE=true
